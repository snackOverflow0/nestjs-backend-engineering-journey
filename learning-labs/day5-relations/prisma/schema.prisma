generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int         @id @default(autoincrement())

  name          String
  description   String

  tasks         Task[]

  createdAt     DateTime    @default(now())
}

model Task {
  id            Int         @id @default(autoincrement())

  title         String
  completed     Boolean     @default(false)

  projectId     Int

  project       Project     @relation(fields: [projectId], references: [id])

  createdAt     DateTime    @default(now())
}